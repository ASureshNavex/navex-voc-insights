{
  "version": "2.0.0",
  "tasks": [
    { "label": "Database: start", "type": "shell", "command": "docker compose up -d postgres" },
    {
      "label": "Database: migrate",
      "type": "shell",
      "command": "uv run alembic upgrade head",
      "options": { "cwd": "${workspaceFolder}/packages/voc-data" }
    },
    {
      "label": "API: run",
      "type": "shell",
      "command": "uv run uvicorn app.main:app --reload --port 8000",
      "options": { "cwd": "${workspaceFolder}/services/experience-api" },
      "isBackground": true
    },
    {
      "label": "Web: run",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/apps/web" },
      "isBackground": true
    },
    {
      "label": "Quality gate: Python",
      "type": "shell",
      "command": "uv run ruff check . && uv run ruff format --check . && uv run mypy && uv run pytest",
      "group": "test"
    },
    {
      "label": "Quality gate: Web",
      "type": "shell",
      "command": "npm run typecheck && npm run lint && npm test && npm run build",
      "options": { "cwd": "${workspaceFolder}/apps/web" },
      "group": "test"
    }
  ]
}
