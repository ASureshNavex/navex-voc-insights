{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API: debug",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--reload", "--port", "8000"],
      "cwd": "${workspaceFolder}/services/experience-api",
      "envFile": "${workspaceFolder}/services/experience-api/.env"
    },
    {
      "name": "Ingestion: debug",
      "type": "debugpy",
      "request": "launch",
      "module": "ingestion",
      "cwd": "${workspaceFolder}/services/ingestion",
      "envFile": "${workspaceFolder}/services/ingestion/.env"
    }
  ]
}
