@echo off
rem harness-managed: regenerated by 'harness init --install', do not edit
rem Install the pinned harness dist into .harness\bin.
rem Linux sibling: bootstrap.sh, same behaviour, same messages, same exit codes.
rem
rem Binaries are never committed to a product repository (spec section 4a item 1).
rem This fetches the pinned dist from the internal Azure DevOps artifact feed,
rem verifies every file in it against MANIFEST.toml, and only then moves
rem anything into .harness\bin. Nothing unverified is ever put in place.
rem
rem The operator supplies the feed. There is no default and no public fallback:
rem
rem   HARNESS_DIST_FEED    base url or directory holding the dist archives. An
rem                        https url on the internal feed, a file:// url, or a
rem                        plain directory path for a mirror on disk.
rem   HARNESS_DIST_TOKEN   optional bearer token for that feed. Read from the
rem                        environment only, never from an argument.
rem
rem Exit codes: 0 ok, 1 failure, 4 missing prerequisite.
setlocal

set "EXIT_FAILURE=1"
set "EXIT_MISSING_PREREQ=4"
set "PINNED_VERSION=0.1.14"
set "MANIFEST_FILE=MANIFEST.toml"
set "MANIFEST_VERSION=1"
set "MAX_ENTRIES=4096"
set "TARGET=x86_64-pc-windows-msvc"

set "HARNESS_DIR=%~dp0"
if "%HARNESS_DIR:~-1%"=="\" set "HARNESS_DIR=%HARNESS_DIR:~0,-1%"
set "WORK_DIR=%HARNESS_DIR%\.bootstrap-tmp"
set "FEED=%HARNESS_DIST_FEED%"
set "VERSION=%PINNED_VERSION%"
set "CHECKED=0"
set "INSTALLABLE=0"

:parse
if "%~1"=="" goto parsed
if /i "%~1"=="-h" goto help
if /i "%~1"=="--help" goto help
if /i "%~1"=="--feed" goto arg_feed
if /i "%~1"=="--version" goto arg_version
if /i "%~1"=="--target" goto arg_target
echo error: unknown argument '%~1' 1>&2
echo run 'bootstrap.bat --help' for usage 1>&2
exit /b %EXIT_FAILURE%

:arg_feed
if "%~2"=="" (set "ERRMSG=--feed needs a value" & goto failure)
set "FEED=%~2"
shift
shift
goto parse

:arg_version
if "%~2"=="" (set "ERRMSG=--version needs a value" & goto failure)
set "VERSION=%~2"
shift
shift
goto parse

:arg_target
if "%~2"=="" (set "ERRMSG=--target needs a value" & goto failure)
set "TARGET=%~2"
shift
shift
goto parse

:help
echo Usage:
echo   bootstrap.bat [--feed ^<url or dir^>] [--version ^<v^>] [--target ^<triple^>]
echo   bootstrap.bat --help
echo.
echo Options:
echo   --feed ^<url or dir^>  internal artifact feed holding the dist archives.
echo                        Defaults to %%HARNESS_DIST_FEED%%.
echo   --version ^<v^>        dist version to install. Defaults to %PINNED_VERSION%.
echo   --target ^<triple^>    dist target. Defaults to this platform.
echo.
echo %%HARNESS_DIST_TOKEN%% is sent as a bearer token when the feed is remote.
exit /b 0

:parsed
rem The version and the target end up in a file name and in a url, so they are
rem checked before either is built. A token outside the allowed set makes the
rem loop body run, which is the refusal.
for /f "delims=0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz.-" %%x in ("%VERSION%") do goto bad_version
for /f "delims=0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz._-" %%x in ("%TARGET%") do goto bad_target
if not defined VERSION goto bad_version
if not defined TARGET goto bad_target
if not defined FEED goto no_feed

rem Windows ships bsdtar, and bsdtar is the tar that reads a zip. Bare `tar`
rem resolves to whatever comes first on PATH, and on a machine with Git for
rem Windows that is Git's GNU tar, which cannot read a zip at all: this script
rem then refused a perfectly good archive with "does not open as a zip" on
rem every developer machine, because Git is a prerequisite for having the
rem repository in the first place. Named by path so PATH cannot decide it.
set "TAR=%SystemRoot%\System32\tar.exe"
if not exist "%TAR%" (set "ERRMSG=tar not found at %TAR%" & goto prereq)
rem The same trap, a second time. Bare `find` is Git's GNU find on the same
rem machines, and GNU find reads `/c` as a path, which under Git is the root of
rem the C drive: counting four lines walked the whole disk for eight minutes and
rem then miscounted. Named by path for the same reason as tar. Used unquoted
rem inside `for /f`, because a quoted first word there is stripped by the cmd
rem it runs under, and the system directory holds no spaces.
set "FIND=%SystemRoot%\System32\find.exe"
if not exist "%FIND%" (set "ERRMSG=find not found at %FIND%" & goto prereq)
where certutil >nul 2>&1 || (set "ERRMSG=certutil not found on PATH" & goto prereq)

set "ARCHIVE_NAME=harness-dist-%VERSION%-%TARGET%.zip"

set "REMOTE=0"
set "SOURCE_DIR=%FEED%"
if /i "%FEED:~0,8%"=="https://" set "REMOTE=1"
if /i "%FEED:~0,7%"=="http://" goto plain_http
if /i "%FEED:~0,7%"=="file://" set "SOURCE_DIR=%FEED:~7%"
set "SCHEME_TEST=%FEED:://=%"
if "%REMOTE%"=="1" goto scheme_ok
if /i "%FEED:~0,7%"=="file://" goto scheme_ok
if not "%SCHEME_TEST%"=="%FEED%" goto bad_scheme

:scheme_ok
if "%REMOTE%"=="0" call :local_dir

if exist "%WORK_DIR%" rd /s /q "%WORK_DIR%" >nul 2>&1
mkdir "%WORK_DIR%" 2>nul
if not exist "%WORK_DIR%" (set "ERRMSG=cannot create the work directory %WORK_DIR%" & goto failure)
set "ARCHIVE=%WORK_DIR%\dist.zip"

if "%REMOTE%"=="1" goto fetch_remote
if not exist "%SOURCE_DIR%\%ARCHIVE_NAME%" (set "ERRMSG=no %ARCHIVE_NAME% in the feed at %SOURCE_DIR%" & goto failure)
copy /y "%SOURCE_DIR%\%ARCHIVE_NAME%" "%ARCHIVE%" >nul
if errorlevel 1 (set "ERRMSG=cannot copy %ARCHIVE_NAME% out of the feed" & goto failure)
goto fetched

:fetch_remote
where curl >nul 2>&1 || (set "ERRMSG=curl not found on PATH" & goto prereq)
if "%FEED:~-1%"=="/" set "FEED=%FEED:~0,-1%"
set "URL=%FEED%/%ARCHIVE_NAME%"
if not defined HARNESS_DIST_TOKEN goto fetch_plain
rem The token goes in a config file rather than on the command line, so it
rem stays out of the process list. The file is deleted as soon as the fetch is
rem over, and the work directory it sits in is removed when this run ends.
> "%WORK_DIR%\curl.cfg" echo header = "Authorization: Bearer %HARNESS_DIST_TOKEN%"
rem https only, and a redirect is followed only to https and three deep. The
rem manifest is hashed before anything is installed, so a redirect cannot
rem substitute content undetected. --location-trusted is deliberately absent,
rem so the token is never forwarded past the feed.
curl --fail --silent --show-error --proto "=https" --location --proto-redir "=https" --max-redirs 3 --config "%WORK_DIR%\curl.cfg" --output "%ARCHIVE%" "%URL%"
set "FETCH_STATUS=%ERRORLEVEL%"
del /q "%WORK_DIR%\curl.cfg" >nul 2>&1
if not "%FETCH_STATUS%"=="0" (set "ERRMSG=cannot fetch %ARCHIVE_NAME% from the feed" & goto failure)
goto fetched

:fetch_plain
curl --fail --silent --show-error --proto "=https" --location --proto-redir "=https" --max-redirs 3 --output "%ARCHIVE%" "%URL%"
if errorlevel 1 (set "ERRMSG=cannot fetch %ARCHIVE_NAME% from the feed" & goto failure)
goto fetched

:fetched
rem Every entry is judged before anything is written to disk. Refusing here,
rem and not after unpacking, is the whole point: an entry that escapes the
rem unpack directory must never be created in the first place.
set "ENTRIES=%WORK_DIR%\entries.txt"
"%TAR%" -tf "%ARCHIVE%" > "%ENTRIES%" 2>nul
if errorlevel 1 (set "ERRMSG=%ARCHIVE_NAME% does not open as a zip" & goto failure)

set "BAD="
for /f "usebackq delims=" %%E in (`findstr /v /r /c:"^[0-9A-Za-z._-][0-9A-Za-z._/-]*[0-9A-Za-z._-]$" /c:"^[0-9A-Za-z._-]$" "%ENTRIES%"`) do if not defined BAD set "BAD=%%E"
if defined BAD goto bad_entry
for /f "usebackq delims=" %%E in (`findstr /c:".." "%ENTRIES%"`) do if not defined BAD set "BAD=%%E"
if defined BAD goto bad_entry

set "ENTRY_COUNT=0"
for /f %%C in ('%FIND% /c /v "" ^< "%ENTRIES%"') do set "ENTRY_COUNT=%%C"
if %ENTRY_COUNT% GTR %MAX_ENTRIES% (set "ERRMSG=%ARCHIVE_NAME% holds more than %MAX_ENTRIES% entries" & goto failure)
if %ENTRY_COUNT% LEQ 0 (set "ERRMSG=%ARCHIVE_NAME% holds no files" & goto failure)

set "TREE=%WORK_DIR%\tree"
mkdir "%TREE%" 2>nul
"%TAR%" -xf "%ARCHIVE%" -C "%TREE%"
if errorlevel 1 (set "ERRMSG=%ARCHIVE_NAME% does not unpack" & goto failure)

set "MANIFEST=%TREE%\%MANIFEST_FILE%"
if not exist "%MANIFEST%" (set "ERRMSG=%ARCHIVE_NAME% carries no %MANIFEST_FILE%" & goto failure)

rem The manifest is read line by line below, so it is whitelisted first: every
rem line has to be one of the forms the generator writes, and no line may hold
rem a cmd metacharacter. A manifest that passes both cannot act on this script.
findstr /v /r /c:"^manifest_version = [0-9][0-9]*$" /c:"^version = .[0-9A-Za-z.-]*.$" /c:"^target = .[0-9A-Za-z._-]*.$" /c:"^path = .[0-9A-Za-z._-][0-9A-Za-z._/-]*.$" /c:"^sha256 = .[0-9a-fA-F][0-9a-fA-F]*.$" /c:"^bytes = [0-9][0-9]*$" /c:"^\[\[files\]\]$" /c:"^$" "%MANIFEST%" >nul
if not errorlevel 1 (set "ERRMSG=%MANIFEST_FILE% holds a line this script does not accept" & goto failure)
findstr /r /c:"[&<>|%%^!]" "%MANIFEST%" >nul
if not errorlevel 1 (set "ERRMSG=%MANIFEST_FILE% holds a line this script does not accept" & goto failure)
findstr /c:".." "%MANIFEST%" >nul
if not errorlevel 1 (set "ERRMSG=%MANIFEST_FILE% refused: a path in it is not a plain relative path" & goto failure)

for /f "usebackq tokens=1,2 delims== " %%a in ("%MANIFEST%") do call :field "%%a" "%%~b"
if defined FAILED goto failure
if %CHECKED% LEQ 0 (set "ERRMSG=%MANIFEST_FILE% lists no files" & goto failure)
if %INSTALLABLE% LEQ 0 (set "ERRMSG=%MANIFEST_FILE% pins nothing under bin/" & goto failure)

rem Anything unpacked that the manifest does not cover is unverified content
rem riding along with verified content. Every listed entry was just found, so
rem equal counts mean the sets are equal.
set "PRESENT=0"
for /f %%C in ('dir /b /s /a-d "%TREE%" 2^>nul ^| %FIND% /c /v ""') do set "PRESENT=%%C"
set /a COVERED=PRESENT-1
if not "%COVERED%"=="%CHECKED%" (set "ERRMSG=%ARCHIVE_NAME% holds %COVERED% files beside %MANIFEST_FILE%, the manifest covers %CHECKED%" & goto failure)

echo ok: %CHECKED% files verified against %MANIFEST_FILE%, hashes recomputed

rem Verified, so now it can move. The work directory is inside .harness, so
rem this is a rename on one volume rather than a copy that can stop half way.
set "DEST=%HARNESS_DIR%\bin"
set "STAGED=%WORK_DIR%\staged-bin"
set "PREVIOUS=%WORK_DIR%\previous-bin"
move /y "%TREE%\bin" "%STAGED%" >nul
if errorlevel 1 (set "ERRMSG=cannot stage the verified binaries" & goto failure)
if not exist "%DEST%" goto install
move /y "%DEST%" "%PREVIOUS%" >nul
if errorlevel 1 (set "ERRMSG=cannot replace %DEST%, close anything still running from it" & goto failure)

:install
move /y "%STAGED%" "%DEST%" >nul
if errorlevel 1 goto install_failed

echo ok: installed %INSTALLABLE% files into %DEST% from %ARCHIVE_NAME%
call :cleanup
exit /b 0

:install_failed
if exist "%PREVIOUS%" move /y "%PREVIOUS%" "%DEST%" >nul
set "ERRMSG=cannot move the verified binaries into %DEST%"
goto failure

rem One manifest field. Called per line, so every %VAR% below reads the value
rem the previous line set, with no delayed expansion to get wrong.
:field
if defined FAILED exit /b 0
set "KEY=%~1"
set "VAL=%~2"
if "%KEY%"=="manifest_version" if not "%VAL%"=="%MANIFEST_VERSION%" (set "FAILED=1" & set "ERRMSG=%MANIFEST_FILE% declares format version '%VAL%', this script reads version %MANIFEST_VERSION%")
if "%KEY%"=="version" if not "%VAL%"=="%VERSION%" (set "FAILED=1" & set "ERRMSG=%MANIFEST_FILE% names version '%VAL%', this install pinned '%VERSION%'")
if "%KEY%"=="target" if not "%VAL%"=="%TARGET%" (set "FAILED=1" & set "ERRMSG=%MANIFEST_FILE% names target '%VAL%', this install needs '%TARGET%'")
if "%KEY%"=="path" set "ENTRY_PATH=%VAL%"
if "%KEY%"=="sha256" set "ENTRY_SHA=%VAL%"
if "%KEY%"=="bytes" goto verify_entry
exit /b 0

:verify_entry
if not defined ENTRY_PATH goto entry_incomplete
if not defined ENTRY_SHA goto entry_incomplete
set "REL=%ENTRY_PATH:/=\%"
set "FILE=%TREE%\%REL%"
if not exist "%FILE%" goto entry_absent
call :hash "%FILE%"
if not defined HASH goto hash_unusable
if not "%HASH:~64,1%"=="" goto hash_unusable
if "%HASH:~63,1%"=="" goto hash_unusable
if /i not "%HASH%"=="%ENTRY_SHA%" goto entry_modified
set "SIZE="
for %%A in ("%FILE%") do set "SIZE=%%~zA"
if not "%SIZE%"=="%VAL%" goto entry_resized
set /a CHECKED+=1
if "%ENTRY_PATH:~0,4%"=="bin/" set /a INSTALLABLE+=1
set "ENTRY_PATH="
set "ENTRY_SHA="
exit /b 0

:entry_incomplete
set "FAILED=1"
set "ERRMSG=%MANIFEST_FILE% has an entry without a path or a sha256"
exit /b 0

:entry_absent
set "FAILED=1"
set "ERRMSG=%MANIFEST_FILE% lists %ENTRY_PATH%, %ARCHIVE_NAME% does not carry it"
exit /b 0

:entry_modified
set "FAILED=1"
set "ERRMSG=%ENTRY_PATH% does not match %MANIFEST_FILE%: recorded %ENTRY_SHA%, recomputed %HASH%"
exit /b 0

:entry_resized
set "FAILED=1"
set "ERRMSG=%ENTRY_PATH% is %SIZE% bytes, %MANIFEST_FILE% records %VAL%"
exit /b 0

:hash_unusable
set "FAILED=1"
set "ERRMSG=cannot recompute the sha256 of %ENTRY_PATH%"
exit /b 0

rem sha256 of one file, into HASH. certutil prints the hash on the line after
rem its banner, and anything that is not 64 hex characters is refused above
rem rather than compared.
:hash
set "HASH="
for /f "skip=1 tokens=1 delims= " %%h in ('certutil -hashfile "%~1" SHA256') do if not defined HASH set "HASH=%%h"
exit /b 0

rem A local feed is written with the separator this platform uses, and a
rem file:///C:/... url keeps the slash cmd cannot follow.
:local_dir
if "%SOURCE_DIR:~0,1%"=="/" if "%SOURCE_DIR:~2,1%"==":" set "SOURCE_DIR=%SOURCE_DIR:~1%"
set "SOURCE_DIR=%SOURCE_DIR:/=\%"
if "%SOURCE_DIR:~-1%"=="\" set "SOURCE_DIR=%SOURCE_DIR:~0,-1%"
exit /b 0

:cleanup
if exist "%WORK_DIR%" rd /s /q "%WORK_DIR%" >nul 2>&1
exit /b 0

rem The refused name is stripped of the characters cmd would act on before it
rem is printed. The sh half needs no equivalent, because it quotes the name.
:bad_entry
set "BAD=%BAD:&=%"
set "BAD=%BAD:<=%"
set "BAD=%BAD:>=%"
set "BAD=%BAD:|=%"
set "BAD=%BAD:^=%"
set "BAD=%BAD:"=%"
set "ERRMSG=%ARCHIVE_NAME% refused: '%BAD%' is not a plain relative path"
goto failure

:bad_version
set "ERRMSG='%VERSION%' is not a version this script will fetch"
goto failure

:bad_target
set "ERRMSG='%TARGET%' is not a target this script will fetch"
goto failure

:plain_http
set "ERRMSG=the feed must be https or a local mirror, '%FEED%' is plain http"
goto failure

:bad_scheme
set "ERRMSG=the feed '%FEED%' uses a scheme this script does not fetch from"
goto failure

:no_feed
set "ERRMSG=no artifact feed configured, set HARNESS_DIST_FEED to the internal feed or pass --feed"
goto prereq

:failure
echo error: %ERRMSG% 1>&2
call :cleanup
exit /b %EXIT_FAILURE%

:prereq
echo error: %ERRMSG% 1>&2
call :cleanup
exit /b %EXIT_MISSING_PREREQ%
